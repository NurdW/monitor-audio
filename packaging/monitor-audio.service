[Unit]
Description=Route application audio to the monitor its window is on
Documentation=file:%h/.local/share/monitor-audio/monitor-audio.py
After=pipewire.service wireplumber.service

[Service]
# Plain simple service: it stays in the foreground and owns the D-Bus name
# local.MonitorAudio itself, which is all KWin needs to reach it.
# env is used rather than a fixed python3 path so the same unit works on distros
# that keep python3 somewhere other than /usr/bin.
Type=simple
ExecStart=/usr/bin/env python3 %h/.local/share/monitor-audio/monitor-audio.py
Restart=on-failure
RestartSec=3
Nice=5

[Install]
WantedBy=default.target
